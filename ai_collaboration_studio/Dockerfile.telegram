# syntax=docker/dockerfile:1
# The supported build context is ./backend (see docker-compose.telegram.yml).
# Only Python source is copied. TDLib, credentials, sessions, databases, and
# downloaded media must be supplied at runtime and never enter the image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN groupadd --gid 10001 telegram \
    && useradd --uid 10001 --gid telegram --create-home --home-dir /home/telegram telegram \
    && mkdir -p /app/backend/providers /app/backend/telegram_intelligence \
        /app/config /app/runtime /opt/tdlib/lib \
    && chown -R telegram:telegram /app /home/telegram

# The build context is backend/, so these globs cannot include project .env,
# runtime SQLite/WAL/SHM, TDLib sessions, keys, or media directories.
COPY --chown=telegram:telegram *.py /app/backend/
COPY --chown=telegram:telegram providers/*.py /app/backend/providers/
COPY --chown=telegram:telegram telegram_intelligence/*.py /app/backend/telegram_intelligence/

USER telegram

VOLUME ["/app/runtime"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import json,urllib.request; p=json.load(urllib.request.urlopen('http://127.0.0.1:8781/health',timeout=2)); raise SystemExit(0 if p.get('ok') is True else 1)"

ENTRYPOINT ["python", "-m", "backend.telegram_intelligence"]
CMD ["telegram", "run"]
