# 只复制实际使用的供应商到本机 .env.local；不要提交真实密钥。

AI_STUDIO_DEFAULT_PROVIDER=deepseek
# 服务端固定禁用列表不能被客户端 skip_providers=[] 削弱；逗号分隔。
AI_STUDIO_DISABLED_PROVIDERS=openai

# 仅用于 manual_chatgpt 的独立 API 审查预算估算；不代表账单或实时价格。
# 三项必须同时填写，否则界面会明确显示未配置或配置无效。
AI_STUDIO_MANUAL_CHATGPT_REVIEW_RATE_LABEL=
AI_STUDIO_MANUAL_CHATGPT_REVIEW_INPUT_USD_PER_MILLION=
AI_STUDIO_MANUAL_CHATGPT_REVIEW_OUTPUT_USD_PER_MILLION=

# 只读 MCP 网关故意不从 .env.local 自动加载授权秘密；请仅在独立进程环境设置。
# AI_STUDIO_MCP_TOKEN_SIGNING_SECRET 必须是至少 32 字节的随机值。
# AI_STUDIO_MCP_ALLOWED_ORIGINS 只在确有浏览器 Origin 时填写精确来源，逗号分隔。
AI_STUDIO_MCP_TOKEN_SIGNING_SECRET=
AI_STUDIO_MCP_ALLOWED_ORIGINS=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_CACHE_TTL_SECONDS=5

# SEC 要求自动访问声明组织或产品名与联系邮箱；该值不是密钥，但不要填写虚假身份。
SEC_USER_AGENT=Your Product Name contact@example.com
SEC_CACHE_TTL_SECONDS=300

# 来源监控默认关闭且仅 dry-run；阶段验收通过前不要开启自动启动。
# OFFICIAL_ONLY=1 与 ALLOW_READONLY_MARKET=1 可同时启用两个独立 Pipeline；
# 只读行情 Pipeline 的首次策略始终固定为 seed_only。
AI_STUDIO_SOURCE_MONITOR_ENABLED=0
AI_STUDIO_SOURCE_MONITOR_AUTO_START=0
AI_STUDIO_SOURCE_MONITOR_OFFICIAL_ONLY=1
AI_STUDIO_SOURCE_MONITOR_ALLOW_READONLY_MARKET=0
AI_STUDIO_SOURCE_MONITOR_DRY_RUN=1
AI_STUDIO_SOURCE_MONITOR_MAX_ITEMS_PER_RUN=50
AI_STUDIO_SOURCE_MONITOR_TRADING_IMPACT_RULES_ENABLED=0
AI_STUDIO_SOURCE_MONITOR_INITIAL_MODE=seed_only
# 受限试用可在启动进程显式设置为 sec_micron_trial_v1；留空沿用默认目录。
# 该配置仅 NVDA 8-K + Micron recent-30，不允许同时打开行情或非 seed_only 初始化。
# 监控变量仍只读取真实进程环境，本示例不会自动启用监控。
AI_STUDIO_SOURCE_MONITOR_PROFILE=
# catch_up 时显式设置 1..50，并绑定已确认的 preview SHA-256：
# AI_STUDIO_SOURCE_MONITOR_CATCH_UP_MAX_ITEMS=10
# AI_STUDIO_SOURCE_MONITOR_INITIAL_PREVIEW_SHA256=<64 lowercase hex>
# from_time 仅筛选首次历史选择，必须使用带时区 RFC3339：
# AI_STUDIO_SOURCE_MONITOR_FROM_TIME=2026-09-01T00:00:00Z
# 只有显式设置下列独立变量时，后续轮询才持续应用事件 cutoff：
# AI_STUDIO_SOURCE_MONITOR_CONTINUOUS_EVENT_CUTOFF=2026-09-01T00:00:00Z
