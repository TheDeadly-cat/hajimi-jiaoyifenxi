# 只复制实际使用的供应商到本机 .env.local；不要提交真实密钥。

AI_STUDIO_DEFAULT_PROVIDER=deepseek
# 服务端固定禁用列表不能被客户端 skip_providers=[] 削弱；逗号分隔。
AI_STUDIO_DISABLED_PROVIDERS=openai

# 仅用于 manual_chatgpt 的独立 API 审查预算估算；不代表账单或实时价格。
# 三项必须同时填写，否则界面会明确显示未配置或配置无效。
AI_STUDIO_MANUAL_CHATGPT_REVIEW_RATE_LABEL=
AI_STUDIO_MANUAL_CHATGPT_REVIEW_INPUT_USD_PER_MILLION=
AI_STUDIO_MANUAL_CHATGPT_REVIEW_OUTPUT_USD_PER_MILLION=

# 只读 MCP 网关故意不从 .env.local 自动加载授权秘密；请仅在独立进程环境设置。
# AI_STUDIO_MCP_TOKEN_SIGNING_SECRET 必须是至少 32 字节的随机值。
# AI_STUDIO_MCP_ALLOWED_ORIGINS 只在确有浏览器 Origin 时填写精确来源，逗号分隔。
AI_STUDIO_MCP_TOKEN_SIGNING_SECRET=
AI_STUDIO_MCP_ALLOWED_ORIGINS=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_CACHE_TTL_SECONDS=5

# SEC 要求自动访问声明组织或产品名与联系邮箱；该值不是密钥，但不要填写虚假身份。
SEC_USER_AGENT=Your Product Name contact@example.com
SEC_CACHE_TTL_SECONDS=300

# Telegram 独立采集入口；仅配置示例，不启动登录、采集、模型或消息发送。
# 凭据和固定目的地保持空白，待本人单独确认后仅写入未跟踪的本机配置。
# 不复用协作室数据库；真实告警还需独立核对权限与目的地，并明确关闭 DRY_RUN。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_TDLIB_LIBRARY_PATH=
TELEGRAM_TDLIB_DATABASE_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESTINATION_CHAT_ID=
TELEGRAM_DATABASE_PATH=runtime/telegram/telegram.sqlite3
TELEGRAM_HEALTH_HOST=127.0.0.1
TELEGRAM_HISTORY_MAX_LIMIT=1000
TELEGRAM_MAX_DATABASE_BYTES=4294967296
TELEGRAM_SHUTDOWN_TIMEOUT_SECONDS=90
ENABLE_AI=false
ENABLE_ALERTS=false
DOWNLOAD_MEDIA=false
DRY_RUN=true
TIMEZONE=Asia/Shanghai
